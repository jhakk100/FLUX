# FLUX 로컬 Gateway 설정 파일
#
# 1) 이 파일을 .env로 복사합니다.
# 2) 아래에서 사용할 공급자 한 가지만 골라 FLUX_PROVIDER를 설정합니다.
# 3) Flux.exe 또는 node 명령을 다시 시작합니다.
#
# 대시보드의 "AI API 설정"에서도 같은 값을 입력할 수 있습니다.
# 대시보드에 저장한 값이 있다면 그 값이 이 파일보다 우선합니다.

# Gateway는 기본적으로 내 PC에서만 접근할 수 있습니다.
FLUX_HOST=127.0.0.1
FLUX_PORT=4317
# 외부 IP에 열 때만 긴 무작위 토큰을 설정하세요.
# FLUX_GATEWAY_TOKEN=change-me-to-a-long-random-value

# 선택지: demo | ollama | lm-studio | google-ai | openai-compatible | openai-chat-compatible | factchat | factchat-responses
FLUX_PROVIDER=demo

# [대화 컨텍스트 관리]
# 추정 사용량이 아래 비율을 넘으면, 최근 12개 메시지를 제외한 이전 대화를 압축 기록으로 바꿉니다.
# FLUX_CONTEXT_TOKEN_BUDGET=24000
# FLUX_CONTEXT_COMPACT_THRESHOLD=0.75

# [Ollama: 내 PC의 로컬 모델]
# Ollama 앱이 실행 중이어야 합니다.
# FLUX_PROVIDER=ollama
# FLUX_OLLAMA_BASE_URL=http://127.0.0.1:11434
# 설치한 정확한 모델 이름을 입력하세요. 멀티모달 모델이면 이미지도 처리할 수 있습니다.
# FLUX_OLLAMA_MODEL=llama3.2-vision:11b
# 선택: FLUX가 매 요청의 options.num_ctx로 Ollama에 요청할 문맥 길이입니다. GPU/RAM 사용량이 커질 수 있습니다.
# FLUX_OLLAMA_CONTEXT_LENGTH=32768

# [LM Studio: 내 PC의 로컬 모델]
# LM Studio에서 Local Server를 시작한 뒤 설정합니다. API 키가 켜진 경우에만 키를 넣으세요.
# FLUX_PROVIDER=lm-studio
# FLUX_LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# FLUX_LMSTUDIO_MODEL=lm-studio에서_불러온_모델_ID
# FLUX_LMSTUDIO_API_KEY=

# [Google AI: Gemini]
# Google AI Studio에서 API 키를 만든 뒤 입력합니다.
# FLUX_PROVIDER=google-ai
# FLUX_GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# FLUX_GOOGLE_AI_MODEL=gemini-2.5-flash
# FLUX_GOOGLE_AI_API_KEY=여기에_Gemini_API_키를_입력

# [OpenAI 공식 API 또는 Responses API 호환 서버]
# OpenAI 공식 주소는 그대로 사용합니다.
# FLUX_PROVIDER=openai-compatible
# FLUX_OPENAI_BASE_URL=https://api.openai.com/v1
# FLUX_OPENAI_MODEL=gpt-5.6-terra
# FLUX_OPENAI_API_KEY=여기에_API_키를_입력

# [조선대학교 FactChat API Gateway]
# 학교에서 발급받은 FactChat 키 하나로 이용 가능한 모델을 선택합니다.
# Chat Completions 전용 모델(Claude/Gemini 등)에 사용합니다. Codex 계열은 이후 Responses 전용 경로를 사용합니다.
# FLUX_PROVIDER=factchat
# FLUX_FACTCHAT_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
# FLUX_FACTCHAT_MODEL=claude-sonnet-4-6
# FLUX_FACTCHAT_API_KEY=학교에서_발급받은_API_키
# Codex 계열은 Responses 전용 경로를 사용합니다.
# FLUX_PROVIDER=factchat-responses

# [학교 제공 API / LM Studio 등 Chat Completions 호환 서버]
# 제공처가 POST /v1/chat/completions를 지원할 때 선택합니다.
# 주소에 /v1을 포함해야 하는지는 제공처 문서를 확인하세요.
# FLUX_PROVIDER=openai-chat-compatible
# FLUX_OPENAI_BASE_URL=https://your-api.example.edu/v1
# FLUX_OPENAI_MODEL=provider-model-name
# FLUX_OPENAI_API_KEY=여기에_제공처_API_키를_입력

# [선택] false로 설정하면 시작 시 브라우저를 자동으로 열지 않습니다.
# FLUX_OPEN_BROWSER=false

# [Discord 봇]
# 토큰만 넣어도 공개 봇이 되지 않도록, 허용할 Discord 사용자 ID를 반드시 하나 이상 넣어야 켜집니다.
# 개발자 모드에서 사용자/채널을 우클릭한 뒤 "ID 복사"를 사용하세요.
# FLUX_DISCORD_BOT_TOKEN=Discord_Developer_Portal에서_발급한_봇_토큰
# FLUX_DISCORD_ALLOWED_USER_IDS=본인_Discord_사용자_ID
# 선택: 비워두면 허용 사용자에게 DM과 멘션 응답을 합니다. 지정하면 그 채널에서만 응답합니다.
# FLUX_DISCORD_ALLOWED_CHANNEL_IDS=개인_채널_ID,또다른_채널_ID

# [Notion 읽기 연결]
# Notion Integration에 읽기 권한만 주고, 사용할 페이지/데이터 소스를 해당 Integration과 공유하세요.
# 현재 FLUX의 Notion 연결은 검색·페이지/블록 읽기 전용이며 변경을 수행하지 않습니다.
# FLUX_NOTION_API_KEY=ntn_또는_secret_형식의_Integration_토큰
# API 버전은 Notion 문서 기준 기본값을 사용합니다. 특별한 호환 사유가 있을 때만 바꾸세요.
# FLUX_NOTION_API_VERSION=2026-03-11
# 선택: 아래 페이지 ID들의 첫 100개 블록을 매 대화에 읽기 전용 참고 자료로 넣습니다(최대 8개).
# FLUX_NOTION_CONTEXT_PAGE_IDS=Notion_페이지_ID,또다른_페이지_ID
