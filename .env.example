# Gateway is intentionally loopback-only by default.
HARU_HOST=127.0.0.1
HARU_PORT=4317
# Required only when binding to a non-loopback address.
# HARU_GATEWAY_TOKEN=change-me-to-a-long-random-value

# Select one: demo, ollama, openai-compatible
HARU_PROVIDER=demo

# Ollama
# HARU_OLLAMA_BASE_URL=http://127.0.0.1:11434
# HARU_OLLAMA_MODEL=your-local-multimodal-model

# OpenAI or another OpenAI-compatible Responses API endpoint
# HARU_OPENAI_API_KEY=
# HARU_OPENAI_MODEL=gpt-5.4
# HARU_OPENAI_BASE_URL=https://api.openai.com/v1
