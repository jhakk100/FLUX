# FLUX 로컬 Gateway 설정 파일
#
# 1) 이 파일을 .env로 복사합니다.
# 2) 아래에서 사용할 공급자 한 가지만 골라 FLUX_PROVIDER를 설정합니다.
# 3) Flux.exe 또는 node 명령을 다시 시작합니다.
#
# 대시보드의 "AI API 설정"에서도 같은 값을 입력할 수 있습니다.
# 대시보드에 저장한 값이 있다면 그 값이 이 파일보다 우선합니다.

# Gateway는 기본적으로 내 PC에서만 접근할 수 있습니다.
FLUX_HOST=127.0.0.1
FLUX_PORT=4317
# 외부 IP에 열 때만 긴 무작위 토큰을 설정하세요.
# FLUX_GATEWAY_TOKEN=change-me-to-a-long-random-value

# 선택지: demo | ollama | openai-compatible | openai-chat-compatible
FLUX_PROVIDER=demo

# [대화 컨텍스트 관리]
# 추정 사용량이 아래 비율을 넘으면, 최근 12개 메시지를 제외한 이전 대화를 압축 기록으로 바꿉니다.
# FLUX_CONTEXT_TOKEN_BUDGET=24000
# FLUX_CONTEXT_COMPACT_THRESHOLD=0.75

# [Ollama: 내 PC의 로컬 모델]
# Ollama 앱이 실행 중이어야 합니다.
# FLUX_PROVIDER=ollama
# FLUX_OLLAMA_BASE_URL=http://127.0.0.1:11434
# 설치한 정확한 모델 이름을 입력하세요. 멀티모달 모델이면 이미지도 처리할 수 있습니다.
# FLUX_OLLAMA_MODEL=llama3.2-vision:11b

# [OpenAI 공식 API 또는 Responses API 호환 서버]
# OpenAI 공식 주소는 그대로 사용합니다.
# FLUX_PROVIDER=openai-compatible
# FLUX_OPENAI_BASE_URL=https://api.openai.com/v1
# FLUX_OPENAI_MODEL=gpt-5.6-terra
# FLUX_OPENAI_API_KEY=여기에_API_키를_입력

# [학교 제공 API / LM Studio 등 Chat Completions 호환 서버]
# 제공처가 POST /v1/chat/completions를 지원할 때 선택합니다.
# 주소에 /v1을 포함해야 하는지는 제공처 문서를 확인하세요.
# FLUX_PROVIDER=openai-chat-compatible
# FLUX_OPENAI_BASE_URL=https://your-api.example.edu/v1
# FLUX_OPENAI_MODEL=provider-model-name
# FLUX_OPENAI_API_KEY=여기에_제공처_API_키를_입력

# [선택] false로 설정하면 시작 시 브라우저를 자동으로 열지 않습니다.
# FLUX_OPEN_BROWSER=false
